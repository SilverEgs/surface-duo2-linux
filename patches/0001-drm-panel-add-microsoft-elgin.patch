+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/elgin.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Surface Duo 2 "elgin" 1344x1892 MIPI-DSI command mode OLED panel
+
+maintainers:
+  - Linux Surface Duo 2 porting effort <linux-arm-msm@vger.kernel.org>
+
+description: |
+  The "elgin" panel module is the OLED panel used by the Microsoft Surface
+  Duo 2.  The device carries two of them, one per DSI controller, with
+  identical geometry and an identical initialisation sequence; they differ
+  only in DDIC stepping, rev "c3" on DSI0 and rev "r2" on DSI1.
+
+  The panel is 1344x1892, DSI command mode, four data lanes, 24 bpp, and uses
+  DSC 1.1 compression with two 672x946 slices per line.  Backlight is DCS
+  based, with an 11 bit display brightness value.
+
+  The DDIC vendor and part number are not confirmed, so the compatible names
+  the panel module rather than the controller.  If the DDIC is later
+  identified, a "<ddic-vendor>,<part>" compatible should be added and
+  "microsoft,elgin" kept as the fallback.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    oneOf:
+      - const: microsoft,elgin
+      - items:
+          - enum:
+              - microsoft,elgin-c3
+              - microsoft,elgin-r2
+          - const: microsoft,elgin
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: 3.0V panel source voltage rail
+
+  vddio-supply:
+    description: 1.8V I/O source voltage rail
+
+  reset-gpios: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vdd-supply
+  - vddio-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "microsoft,elgin-c3", "microsoft,elgin";
+            reg = <0>;
+
+            reset-gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
+
+            vdd-supply = <&vreg_oled_vdd>;
+            vddio-supply = <&vreg_oled_vddio>;
+
+            port {
+                panel0_in: endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
+
+...
